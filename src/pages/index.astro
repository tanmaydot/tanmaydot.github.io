---
import Base from "../layouts/Base.astro";
const projects = [
  {
    n: "AWS S3 File Downloader",
    d: "A Node.js utility that downloads files from an S3 bucket by file key, useful for pulling images or videos.",
    t: "Node, AWS, S3",
    src: "https://github.com/tanmaydot/getS3Image",
  },
  {
    n: "BlogCord",
    d: "Astro blog template discord theme",
    t: "Astro, Javascript",
    src: "https://github.com/tanmaydot/BlogCord",
    demo: "https://blog-cord-ten.vercel.app/",
  },
  {
    n: "Jelly Spinel Beans Theme",
    d: "Blended Theme For Vs Code: Jellybeans + Shopify Ruby",
    t: "Node",
    src: "https://github.com/tanmaydot/jelly_spinel_beans_theme",
    demo: "https://marketplace.visualstudio.com/items?itemName=tanmaydot.jelly-spinel-beans-theme",
  },
  {
    n: "Ultimate Football Data",
    d: "A Django app with live football data: leagues, teams, matches and standings from the Football Data API.",
    t: "Python, Django, REST API",
    src: "https://github.com/tanmaydot/ultimate_football_data",
    demo: "https://ufd-lbwc.onrender.com/",
  },
  {
    n: "Ultimate Football Dashboard",
    d: "A Django dashboard for football fans covering leagues, teams, matches and standings for Premier League clubs.",
    t: "Python, Django, REST API",
    src: "https://github.com/tanmaydot/ultimate_football_dashboard",
    demo: "https://ufd-uf96.onrender.com/dashboard/",
  },
];
---

<Base>
  <header class="wrap bar">
    <a class="logo" href="/" aria-label="Tanmay Sharma, back to top"
      ><svg
        viewBox="0 0 48 48"
        width="40"
        height="40"
        fill="none"
        stroke-width="4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M6 10h20M16 10v28" stroke="currentColor"></path><path
          d="M42 14C42 7 28 7 28 16c0 9 14 6 14 15 0 8-14 8-14 3"
          stroke="var(--red)"></path></svg
      ></a
    ><nav>
      <a href="#project">Projects</a>
      <a href="#contact">Socials</a>
    </nav>
  </header>
  <main id="top">
    <section class="wrap hero" id="hero">
      <h1 id="name">Tanmay Sharma</h1>
      <div class="intro">
        <p>
          Full Stack Developer with 3 years of experience specializing in Ruby
          on Rails and JavaScript, with a focus on automation and data
          processing, infrastructure management, mobile application development,
          and deployments. Committed to writing clean, maintainable code that
          follows DRY principles.
        </p>
        <p class="act">
          <a
            class="btn"
            href="/resume_tanmay_sharma.pdf"
            download="Tanmay_Sharma_Resume.pdf">Download Resume</a
          >
        </p>
      </div>
    </section>

    <section id="project">
      <div class="wrap sec">
        <h2>Projects</h2>
        <p class="ctl">
          <button id="prev" aria-label="Previous projects">&larr;</button
          ><button id="next" aria-label="Next projects">&rarr;</button>
        </p>
      </div>
      <div
        class="rail"
        id="rail"
        tabindex="0"
        role="region"
        aria-label="Projects, scroll sideways"
      >
        {
          projects.map((p) => (
            <article class="card">
              <>
                <h3>{p.n}</h3>
                <p>{p.d}</p>
                <p class="m">{p.t}</p>
              </>
              <p class="lk">
                <a href={p.src} target="_blank" rel="noopener">
                  Source
                </a>
                {p.demo && (
                  <a href={p.demo} target="_blank" rel="noopener">
                    Live demo
                  </a>
                )}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="wrap row" id="contact">
      <h2>Socials</h2>
      <div>
        <p class="lk">
          <a
            href="mailto:reachtanmays@gmail.com"
            target="_blank"
            rel="noopener"
          >
            Email
          </a>
          <a href="https://github.com/tanmaydot" target="_blank" rel="noopener">
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/tanmaydot/"
            target="_blank"
            rel="noopener"
          >
            LinkedIn
          </a>
        </p>
      </div>
    </section>
  </main>
</Base>

<script>
  const h = document.getElementById("hero")!,
    n = document.getElementById("name")!;
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    h.addEventListener("pointermove", (e) => {
      const r = h.getBoundingClientRect(),
        x = (e.clientX - r.left) / r.width,
        y = (e.clientY - r.top) / r.height;
      n.style.setProperty("--w", String(Math.round(120 + x * 760)));
      n.style.setProperty("--s", String(Math.round(y * 100)));
    });
  }
  const rail = document.getElementById("rail")!;
  const step = (d: number) =>
    rail.scrollBy({
      left: d * (rail.querySelector(".card")!.clientWidth + 20),
      behavior: "smooth",
    });
  document.getElementById("prev")!.addEventListener("click", () => step(-1));
  document.getElementById("next")!.addEventListener("click", () => step(1));
</script>

<style is:global>
  :root {
    --bg: #1f2328;
    --surface: #282c33;
    --line: #3a3f48;
    --ink: #dadde3;
    --mute: #9096a2;
    --red: #e8505b;
    --gut: max(1.5rem, calc((100vw - 1120px) / 2 + 1.5rem));
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    background: var(--bg);
    color: var(--ink);
    font:
      400 1.05rem/1.6 "Instrument Sans",
      sans-serif;
  }
  a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--red);
  }
  :focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .sec {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 2rem;
    padding-top: 4rem;
    padding-bottom: 4rem;
    border-top: 1px solid var(--line);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.2rem;
    padding-bottom: 1.2rem;
  }
  .bar a {
    text-decoration: none;
  }
  .bar nav {
    display: flex;
    gap: 1.6rem;
  }
  .logo {
    display: block;
    color: var(--ink);
  }
  .logo:hover svg path:last-child {
    stroke-dasharray: 90;
    animation: draw 0.9s ease-out;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 90;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .hero {
    padding-top: 7vh;
    padding-bottom: 6rem;
  }
  #name {
    font-family: Fraunces, serif;
    font-size: clamp(3.6rem, 13vw, 11rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    font-weight: 400;
    font-variation-settings:
      "wght" var(--w, 420),
      "opsz" 144,
      "SOFT" var(--s, 40);
    transition: font-variation-settings 0.25s ease-out;
    max-width: 7ch;
  }
  .intro {
    max-width: 34rem;
    margin: 3rem 0 0 auto;
    font-size: 1.2rem;
  }
  .act {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin-top: 1.6rem;
    font-size: 1rem;
  }
  .btn {
    background: var(--ink);
    color: var(--bg);
    padding: 0.7rem 1.3rem;
    border-radius: 99px;
    text-decoration: none;
  }
  .btn:hover {
    background: var(--red);
    color: var(--bg);
  }
  h2 {
    font-size: 1rem;
    font-weight: 600;
  }
  h3 {
    font:
      500 1.5rem/1.2 Fraunces,
      serif;
    margin-bottom: 0.5rem;
  }
  #project {
    padding: 3.5rem 0;
    /* border-top: 1px solid var(--line); */
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.6rem;
  }
  .ctl {
    display: flex;
    gap: 0.6rem;
  }
  .ctl button {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: none;
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .ctl button:hover {
    border-color: var(--red);
    color: var(--red);
  }
  .rail {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.3rem var(--gut) 1.4rem;
    scroll-padding: 0 var(--gut);
    scrollbar-color: var(--line) transparent;
  }
  .card {
    flex: 0 0 min(340px, 80vw);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    min-height: 270px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.5rem;
  }
  .card .lk {
    margin-top: auto;
    padding-top: 1.2rem;
  }
  .m {
    color: var(--mute);
    font-size: 0.95rem;
    margin-top: 0.6rem;
  }
  .lk {
    display: flex;
    gap: 1.2rem;
    white-space: nowrap;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 2rem;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
    border-top: 1px solid var(--line);
  }
  .role {
    font:
      500 1.5rem/1.3 Fraunces,
      serif;
    margin-bottom: 0.8rem;
  }
  .role .m {
    font-family: "Instrument Sans";
  }
  .lead {
    color: var(--mute);
    margin-bottom: 2rem;
  }
  .item {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--line);
  }
  .item h3 {
    font: 600 1.05rem/1.6 "Instrument Sans";
    margin: 0;
  }
  .item p {
    max-width: 58ch;
  }
  .item p + p {
    margin-top: 0.6rem;
  }
  .k {
    display: inline-block;
    min-width: 5.2rem;
    color: var(--red);
    font-weight: 600;
    font-size: 0.95rem;
  }
  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .intro {
      margin-left: 0;
    }
    .item {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .k {
      display: block;
    }
  }
</style>
